# Anvaya configuration.
#
# Everything here is optional — the server runs with no configuration at all.
# Copy to `.env` only if you need to change something, and note that `.env` is
# gitignored on purpose.

# ── collector ───────────────────────────────────────────────────────────────
ANVAYA_HOST=127.0.0.1
ANVAYA_PORT=4319
ANVAYA_DB_PATH=./data/anvaya.db

# Storage driver: sqlite (self-hosted) or postgres (serverless). Inferred as
# postgres whenever a connection string is present.
# ANVAYA_STORAGE_DRIVER=sqlite
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Ingest mode: `worker` buffers in memory and analyses on a timer; `inline`
# persists on arrival and analyses inside the request. Serverless hosts have no
# event loop between invocations, so they must use inline (auto on Vercel).
# ANVAYA_INGEST_MODE=worker

# Shared ingest/read key. Unset means the API is unauthenticated and the server
# says so loudly at startup. If you set it, also set VITE_ANVAYA_API_KEY below,
# or the dashboard will 401.
# ANVAYA_API_KEY=change-me

# Set false to refuse all spans: POST /v1/ingest returns 403 INGEST_DISABLED and
# reads keep working. Intended for a public demo, where an open write endpoint in
# front of a free-tier database is an invitation to fill it. An API key is not a
# substitute there — a browser dashboard ships its key to the client, so on a
# public deployment that key is readable by anyone who opens devtools.
# ANVAYA_INGEST_ACCEPT_WRITES=true

# Never enable in production: this returns stack traces in API errors.
ANVAYA_DEV_MODE=false

# Serve the built dashboard from this server (single origin, no CORS). The bundle
# is located automatically; set ANVAYA_UI_PATH only for a non-standard layout.
ANVAYA_SERVE_UI=true
# ANVAYA_UI_PATH=/srv/anvaya/ui

# ── logging ─────────────────────────────────────────────────────────────────
ANVAYA_LOG_LEVEL=info
ANVAYA_LOG_FORMAT=pretty

# ── detection ───────────────────────────────────────────────────────────────
ANVAYA_DETECTION_ENABLED=true

# ── judge tier (L3) ─────────────────────────────────────────────────────────
# OFF by default because it costs money per trace. A key alone is not enough:
# the tier must also be switched on explicitly.
ANVAYA_JUDGE_ENABLED=false
ANVAYA_JUDGE_PROVIDER=anthropic
ANVAYA_JUDGE_MODEL=claude-haiku-4-5-20251001
ANVAYA_JUDGE_SAMPLE_RATE=0.1
# ANTHROPIC_API_KEY=sk-ant-...

# Point at a gateway, an egress proxy, or a local fake instead of the provider.
# ANVAYA_JUDGE_BASE_URL=https://api.anthropic.com

# ── retention ───────────────────────────────────────────────────────────────
ANVAYA_RETENTION_DAYS=30

# ── alerts ──────────────────────────────────────────────────────────────────
# ANVAYA_ALERTS_WEBHOOK=https://hooks.example.com/...

# ── dashboard (build-time, Vite) ────────────────────────────────────────────
VITE_ANVAYA_API=http://localhost:4319
# Must match ANVAYA_API_KEY when the collector is authenticated.
# VITE_ANVAYA_API_KEY=change-me
